## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This file is based on the standard GitHub .NET gitignore template.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
Log/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache and settings
.vs/
# Uncomment if you want to ignore the whole .vs folder
# .vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Windows image-cache files
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on VFAT chunks
$RECYCLE.BIN/

# VS Code directories
.vscode/
# .vscode/*
# !.vscode/settings.json
# !.vscode/tasks.json
# !.vscode/launch.json
# !.vscode/extensions.json
# !.vscode/project.snippets

# Built-in analyze tools
*.DotSettings.user

# Project-specific overrides
**/bin/
**/obj/

# Environment Secret Files
appsettings.json
!appsettings.json
appsettings.Development.json
# Secrets should ideally not be committed, but appsettings.json usually is as a template.
# If you use User Secrets, they are stored outside the project tree.

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet Config to specify a packages directory
# NuGet.Config
# NuGet.exe

# Rider
.idea/
*.sln.iml

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
/SCM_Smart_Menu.postman_collection.json

**/uploads
